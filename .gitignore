# ============================================================================
# nvmon .gitignore
# ============================================================================

# ------------ Python ------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual envs
.venv/
venv/
env/
ENV/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ------------ IDEs / OS ------------
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
.DS_Store
desktop.ini

# ------------ Beads / Dolt ------------
.dolt/
*.db
.beads-credential-key

# ------------ Workspace-level dev tooling (NOT product) ------------
# These live at the workspace root and are NEVER part of the deployable.
/python/
/data/
/.openviking/
/node_modules/
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
/tests/screenshots/
/requirements.txt
/package.json
/package-lock.json
/ov.conf

# ------------ Stale workspace docs (preserved locally, not in repo) ------------
/KICKOFF.md

# ------------ OLDVERSION (kept locally as reference, not shipped) ------------
/OLDVERSION/

# ------------ Logo WIP ------------
/logo-mockups/

# ------------ AI-agent / dev workspace (not part of product release) ------------
.claude/
.beads/
CLAUDE.md
AGENTS.md

# ============================================================================
# NVMON/ product — per-node / runtime state never committed
# ============================================================================

# Enclosed Python (regenerated by install.bat from python.org embed)
NVMON/python/

# Daily logs + install logs (keep dir via .gitkeep)
NVMON/logs/*
!NVMON/logs/.gitkeep

# Per-node password file + push-registered nodes (keep dir via .gitkeep)
NVMON/secrets/*
!NVMON/secrets/.gitkeep

# Per-node runtime telemetry / boot-apply snapshot
NVMON/status.json
NVMON/active_profile.json

# Per-node config + zero-touch controller URL
NVMON/nvmon.toml
NVMON/monitor.url

# Operator-dropped EDID overrides (per-node hardware)
NVMON/Edids/*
!NVMON/Edids/.gitkeep

# Operator-managed profile library (user JSON; *.example.json is committed)
NVMON/profiles/*.json
!NVMON/profiles/*.example.json
!NVMON/profiles/.gitkeep
# Site backups of profiles / raw hardware dumps / vendor-ticket drafts: site data, never committed
NVMON/profiles/_backup/

# FreeFileSync / robocopy mirror state + configs (contain local paths, IPs)
*.ffs_db
*.ffs_lock
*.ffs_tmp
*.ffs_gui
*.ffs_batch

# Windows shortcuts (nvmon app --shortcuts writes nvmon.lnk with this box's
# absolute paths / UNC share) — per machine, never committed
*.lnk

# Deep-research scratch (if a session leaves it behind)
/research_notes/
/reports/

# Site-specific notes and tools: kept on the site's own copy, never published
/HANDOFF.md
NVMON/HANDOFF.md
NVMON/docs/*-LESSONS-*.md
NVMON/docs/specs/
NVMON/bats/Rate-Cycle.ps1
NVMON/bats/chain_readout.py
NVMON/FREEFILESYNC_EXCLUDES.txt

# update_site.bat backups (per site)
NVMON/backup/

# Dev / handoff artifacts inside NVMON
NVMON/.no_autostart
NVMON/Run

# Keep placeholder files (must come last to override any wildcard above)
!NVMON/secrets/.gitkeep
!NVMON/logs/.gitkeep
!NVMON/bin/.gitkeep

# ------------ NVIDIA CLI tools (NVMON/bin/) ------------
# NVIDIA software under NVIDIA licence terms - not redistributed here.
# Download from NVIDIA and drop in NVMON/bin/ (see README "Required NVIDIA tools").
NVMON/bin/configureMosaic.exe
NVMON/bin/configureMosaic-2.5.3.exe
NVMON/bin/configureMosaic-2.5.3-readme.txt
NVMON/bin/configureDdisplay.exe
NVMON/bin/configureQsync2.exe
