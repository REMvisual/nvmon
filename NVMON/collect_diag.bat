@echo off
REM ============================================================
REM  nvmon diagnostic collector — double-click on the render node.
REM  Writes everything Claude needs into nvmon_diag.txt and opens it.
REM  No arguments needed. Safe / read-only (it does NOT change sync).
REM ============================================================
setlocal enabledelayedexpansion
cd /d "%~dp0"

set "OUT=nvmon_diag.txt"
set "PY=python\python.exe"

echo Collecting nvmon diagnostics...  (this takes a few seconds)

> "%OUT%" echo nvmon diagnostic report
>> "%OUT%" echo generated by collect_diag.bat
>> "%OUT%" echo host: %COMPUTERNAME%
>> "%OUT%" echo ============================================================
>> "%OUT%" echo.

REM --- 1. live subsystem state + RAW tool output (qsync queryAll, mosaic query) ---
if exist "%PY%" (
    "%PY%" diag_displays.py >> "%OUT%" 2>&1
) else (
    >> "%OUT%" echo ERROR: %PY% not found - run this from inside the NVMON folder.
)

REM --- 2. newest saved profile JSON ---
>> "%OUT%" echo.
>> "%OUT%" echo ============================================================
>> "%OUT%" echo NEWEST SAVED PROFILE
>> "%OUT%" echo ============================================================
set "GOTPROFILE="
for /f "delims=" %%F in ('dir /b /o-d profiles\*.json 2^>nul') do (
    if not defined GOTPROFILE (
        set "GOTPROFILE=1"
        >> "%OUT%" echo --- profiles\%%F ---
        type "profiles\%%F" >> "%OUT%"
    )
)
if not defined GOTPROFILE >> "%OUT%" echo (no profiles found)

REM --- 3. recent log lines about sync / mosaic / enable failures ---
>> "%OUT%" echo.
>> "%OUT%" echo ============================================================
>> "%OUT%" echo RECENT LOG (qsync / mosaic / enable / drift / failed)
>> "%OUT%" echo ============================================================
powershell -NoProfile -Command "$f = Get-ChildItem 'logs\*.log' -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 1; if ($f) { Get-Content $f.FullName | Select-String -Pattern 'QSync|enabling|enable|Mosaic|grid|display=|failed|converge|drift|source=|role' | Select-Object -Last 80 | ForEach-Object { $_.Line } } else { 'no log files found in logs\' }" >> "%OUT%" 2>&1

echo.
echo ============================================================
echo Done. Report written to: %CD%\%OUT%
echo Send that file (or its contents) to Claude.
echo ============================================================
start "" notepad "%OUT%"
endlocal
